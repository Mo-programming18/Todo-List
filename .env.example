# Copy to .env (and .env.local for secrets) and fill in.

# MySQL connection — used by Prisma CLI and the app runtime.
DATABASE_URL="mysql://user:password@localhost:3306/todo_db"

# Auth.js — required. Generate with: npx auth secret
AUTH_SECRET="replace-me"

# OAuth (optional) — enable GitHub / Google sign-in.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
